# Node
ra-interface/node_modules/
ra-interface/coverage/

# Python
__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage.xml

# ── NEVER COMMIT THESE ──────────────────────────────────────────────────────
# Private key files — blocked globally regardless of location
*.key

# Binary containers that embed private keys
*.p12
*.pfx
*.jks

# *.pem is NOT blocked globally because PEM can legitimately contain
# public CA chains and trust anchors. The dangerous directories are
# blocked explicitly below instead.

# Certbot account directories contain RSA account private keys in JWK form
certbot/config/accounts/

# Offline HSM ceremony output contains the Root CA private key
offline_hsm/

# Certificate issuance output from scripts (contain issued-cert private keys)
*_cert.json
blue_cert.json
scada_cert.json
meter_cert.json
user_cert.json

# Other generated output
monitoring_reports/
revocation.crl
